# Copier en .env et adapter.
# Dossier contenant les sorties GoPro (vu comme /photos dans l'application)
PHOTOS_DIR=./photos
# Dossier des exports en mode « copie » (vu comme /exports)
EXPORTS_DIR=./exports
# Projets de l'application (bases, miniatures)
DATA_DIR=./data
# Utilisateur et groupe propriétaires des fichiers (commande : id -u ; id -g)
PUID=1000
PGID=1000
PORT=8765
