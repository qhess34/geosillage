# GeoSillage — environnement unique des agents IA (Docker Agent / cagent), voir doc/ORGANISATION_IA.md.
# Même base que le Dockerfile du projet (Ubuntu 24.04, Python venv, ExifTool 12.76) + Node 22, git,
# Playwright (Chromium) et le binaire cagent. Aucun secret : les clés passent par l'environnement.
FROM node:22-bookworm-slim AS node

FROM ubuntu:24.04
ARG CAGENT_VERSION=v1.30.0
ARG PLAYWRIGHT_VERSION=1.63.0
# Node 22 (copié de l'image officielle)
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv libimage-exiftool-perl \
       git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
# Chromium de Playwright (version = e2e/package.json) + ses bibliothèques système
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN npm install -g playwright@${PLAYWRIGHT_VERSION} \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* /root/.npm
# Binaire Docker Agent (cagent), version épinglée
RUN curl -fsSL -o /usr/local/bin/cagent \
      "https://github.com/docker/cagent/releases/download/${CAGENT_VERSION}/cagent-linux-$(dpkg --print-architecture)" \
    && chmod +x /usr/local/bin/cagent
# Utilisateur non root ; dossiers de dépendances créés pour que les volumes nommés en héritent
RUN git config --system --add safe.directory '*' \
    && mkdir -p /work/geosillage/.venv /work/geosillage/frontend/node_modules /work/geosillage/e2e/node_modules \
    && chown -R ubuntu:ubuntu /work
USER ubuntu
ENV HOME=/home/ubuntu PYTHONUNBUFFERED=1
WORKDIR /work/geosillage
CMD ["cagent", "run", "doc/agents/geosillage.yaml"]
